# hh.ru API: User-Agent (обязателен) — формат AppName/Version (email)
HH_USER_AGENT=AutoHH/1.0 (contact@example.com)

# Задержка между API-запросами в миллисекундах
REQUEST_DELAY_MS=1500

# Путь к конфигу
CONFIG_PATH=./config.json

# Личный список исключаемых компаний — через запятую, без кавычек.
# Живёт в .env, поэтому в git не попадает. Пустое значение = config.json → filter.excludedCompanies.
EXCLUDED_COMPANIES=

# Playwright: путь к директории с persistent-профилем браузера (где живёт сессия hh.ru)
PW_USER_DATA_DIR=./data/browser-profile

# Playwright: запускать ли в headless-режиме при отклике (true/false).
# Для логина (пункт меню «🔑 Войти на hh.ru») всегда headful.
PW_HEADLESS=false

# Минимальная и максимальная пауза между откликами, мс (выбирается рандомно в диапазоне)
PW_MIN_DELAY_MS=8000
PW_MAX_DELAY_MS=20000

# Что делать с вакансиями, требующими тест:
#   skip   — пропустить (старое поведение)
#   manual — приостановить, дать ответить вручную в браузере, ждать ENTER в консоли
PW_TEST_MODE=manual

# Сколько ждать ручного ответа на тест, мс (0 = бесконечно)
PW_TEST_TIMEOUT_MS=0

# ИИ для судьи (digest) и сопроводительных писем (cover).
# Провайдер задаётся OpenAI-совместимым config.json → api.baseUrl,
# модель — config.json → api.model (переменная CLAUDE_MODEL перебивает api.model).
# Ключ ищется по порядку: config.json → api.apiKey, OPENAI_API_KEY, ANTHROPIC_API_KEY.
# Для Z.ai: baseUrl = https://api.z.ai/api/paas/v4/, model = glm-4.7-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/   # перебивает api.baseUrl из config.json
# CLAUDE_MODEL=glm-4.7-flash

# Максимум токенов на один ответ модели (у GLM-4.7 предел 131072).
# Thinking-модели тратят часть лимита на рассуждения, поэтому запас должен быть больше ответа.
AI_MAX_TOKENS=32768

# Сколько ИИ-запросов выполнять одновременно. Бесплатные тарифы часто режут параллелизм:
# при 429 снижайте (1-3) и/или уменьшайте JUDGE_BATCH_SIZE / COVER_BATCH_SIZE.
AI_CONCURRENCY=10

# Ретраи ИИ-запросов: всего попыток, базовая пауза (мс) и её потолок (мс).
# Повторяются только 429/5xx/сетевые ошибки, учитывается заголовок Retry-After.
AI_RETRY_ATTEMPTS=5
AI_RETRY_BASE_MS=1000
AI_RETRY_MAX_MS=30000

# Краткое описание соискателя — попадает в системный промпт ИИ
APPLICANT_PROFILE=Node.js разработчик, 3 года опыта. Стек: Node.js, TypeScript, React, PostgreSQL, Docker. Ищу удалённую работу или офис в Москве.

# Подпись сопроводительного письма. Используется системным промптом ИИ и
# плейсхолдером {signature} в config.json → apply.coverLetterTemplate.
# Реальные контакты держите только здесь: файл .env не попадает в git.
COVER_SIGNATURE=Telegram: <your-telegram>, e-mail: <your-email>

# Путь к резюме (.txt / .md / .pdf). ИИ читает его и сравнивает с каждой вакансией.
# Если хотите использовать несколько резюме — оставьте RESUME_PATH пустым и задайте RESUMES_DIR.
RESUME_PATH=

# Директория с несколькими резюме. Каждый файл — отдельное резюме, имя файла без расширения = ключ.
# Выбор при запуске: пункты меню «🧠 Собрать дайджест» и «✉️ Письма для дайджеста» спросят резюме.
RESUMES_DIR=./resumes

# MongoDB URI для кэша, истории и дайджестов
MONGODB_URI=mongodb://localhost:27017/autohh

# Таймаут подключения к MongoDB, мс: если база недоступна, команды сообщат об этом быстро,
# а не будут ждать дефолтные 30 секунд
MONGODB_TIMEOUT_MS=10000

# Сколько вакансий в одной пачке на оценку ИИ (судья) и на генерацию писем
JUDGE_BATCH_SIZE=10
COVER_BATCH_SIZE=20
