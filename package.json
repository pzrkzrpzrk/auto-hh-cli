{
  "name": "auto-hh-cli",
  "version": "1.0.0",
  "description": "Search & filter vacancies on hh.ru, apply via Playwright",
  "bin": {
    "auto-hh": "./bin/auto-hh"
  },
  "scripts": {
    "start": "node bin/auto-hh",
    "ui": "node bin/auto-hh ui",
    "build": "npm run arch && tsc",
    "arch": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tests",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "openai": "^6.37.0",
    "playwright": "^1.48.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "@types/node-cron": "^3.0.11",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
