{
  "name": "auto-hh-cli",
  "version": "1.0.0",
  "description": "Search & filter vacancies on hh.ru, apply via Playwright",
  "bin": {
    "auto-hh": "./bin/auto-hh"
  },
  "scripts": {
    "start": "node bin/auto-hh",
    "ui": "node bin/auto-hh ui",
    "build": "tsc",
    "watch": "tsc --watch",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:create": "migrate-mongo create"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@inquirer/prompts": "^7.10.1",
    "@types/node": "^25.7.0",
    "axios": "^1.7.7",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.2.0",
    "node-cron": "^4.2.1",
    "openai": "^6.37.0",
    "playwright": "^1.48.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
